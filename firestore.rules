rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products: readable by everyone, write restricted
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: creation allowed with validated payload, read allowed for status tracking
    match /orders/{orderId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.resource.data.keys().hasAll(['id', 'createdAt', 'customerPhone', 'items', 'totalAmount', 'status'])
                    && request.resource.data.customerPhone is string
                    && request.resource.data.customerPhone.size() > 0
                    && request.resource.data.totalAmount is number;
      allow update, delete: if request.auth != null;
    }

    // Settings: readable by everyone for public store details, write restricted
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
