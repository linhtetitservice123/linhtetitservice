rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products: readable by everyone, write restricted
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: creation allowed with validated payload, read allowed for status tracking
    match /orders/{orderId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.resource.data.keys().hasAll(['id', 'createdAt', 'customerPhone', 'items', 'totalAmount', 'status'])
                    && request.resource.data.customerPhone is string
                    && request.resource.data.customerPhone.size() > 0
                    && request.resource.data.totalAmount is number;
      allow update, delete: if request.auth != null;
    }

    // Reviews: readable by everyone to build customer trust, creation validated
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'customerName', 'rating', 'comment', 'createdAt'])
                    && request.resource.data.customerName is string
                    && request.resource.data.customerName.size() > 0
                    && request.resource.data.customerName.size() <= 100
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() > 0
                    && request.resource.data.comment.size() <= 1000;
      allow update, delete: if request.auth != null;
    }

    // Settings: readable by everyone for public store details, write restricted
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
